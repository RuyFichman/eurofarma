# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local (esta no .gitignore).

# Conexao com o Postgres (Supabase).
# Pegue a string exata em: Dashboard > Project Settings > Database > Connection string
# - Conexao direta (migrations): porta 5432
# - Conexao via pooler (runtime serverless): porta 6543 com ?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# Cliente Supabase (frontend / supabase-js). A publishable key e publica por design.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# WhatsApp Cloud API (Sprint 6.5) - server-only, NUNCA com prefixo NEXT_PUBLIC_.
# Enquanto nao existirem, o webhook recusa toda requisicao (sem APP_SECRET nao ha
# como validar a assinatura) e o bot fica mudo (sem ACCESS_TOKEN nao ha envio).
# VERIFY_TOKEN: string que voce inventa e repete no painel da Meta ao cadastrar
# o webhook. APP_SECRET: Meta App > Settings > Basic > App Secret.
# ACCESS_TOKEN e PHONE_NUMBER_ID: Meta App > WhatsApp > API Setup.
WHATSAPP_VERIFY_TOKEN="invente-uma-string-longa"
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Opcional - default v21.0
WHATSAPP_API_VERSION=""

# Supabase Admin API (server-only) - usado por `pnpm db:seed-admin` e, desde a
# Sprint 6.2, pelo proprio app em `POST /api/nutriz` (cria a conta da nutriz ja
# confirmada). Sem estas duas variaveis o cadastro responde 500.
# Pegue em: Dashboard > Project Settings > API > service_role (a key longa eyJ...).
# NUNCA commitar a real nem expor no client.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGc..."

# Admin inicial provisionado por `pnpm db:seed-admin` (use email dedicado, nao pessoal).
INITIAL_ADMIN_EMAIL="admin@lactare.local"
