  <folder name="Motivation" id="id-f57faf4ca8204356bc96cb9abdb54ba1" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Eurofarma(Projeto Lactare)" id="id-8d3c5cb28a644f93a122865fd54b446d"/>
    <element xsi:type="archimate:Driver" name="Baixo alcance e captação de nutrizes doadoras para o projeto Lactare" id="id-bb6cadc8194b48d9bdf7b547bc0f655c"/>
    <element xsi:type="archimate:Goal" name="Ampliar o alcance e a conscientização sobre doação de leite humano" id="id-49607694a2094428898a4ef8f8b3fffe"/>
    <element xsi:type="archimate:Goal" name="Viabilizar o processo da nutriz à doação de leite humano" id="id-42c541030db745f698d8c578291ba41d"/>
    <element xsi:type="archimate:Goal" name=" Gerar dashboards e relatórios para acompanhamento da captação e engajamento das nutrizes" id="id-2ff9699002be42c38e09d917ba272994"/>
    <element xsi:type="archimate:Outcome" name=" Aumentar 30% das nutrizes únicas com primeiro contato via WhatsApp ou Instagram por mês" id="id-b42343602c5744e0a972268ea89ddbb2"/>
    <element xsi:type="archimate:Outcome" name="Atingir 60% de taxa de engajamento entre as nutrizes que iniciaram o primeiro contato" id="id-0d23bb982cf44560a8d792f58b02502a"/>
    <element xsi:type="archimate:Requirement" name="Disparar campanhas segmentadas por região via WhatsApp pelo painel administrativo" id="id-af4dced9f5f54898848c00f7800fd2bd"/>
    <element xsi:type="archimate:Requirement" name="Realizar cadastro simplificado da nutriz com verificação de duplicidade via CPF" id="id-13062bf715584cdaa4152b269a2e8c45"/>
    <element xsi:type="archimate:Requirement" name="Disponibilizar na plataforma web biblioteca de conteúdos educativos e painel de impacto do projeto" id="id-dd28eee4bde34c9ab0034798b2104297"/>
    <element xsi:type="archimate:Requirement" name="A solução deve estar disponível 24/7 nos canais de entrada" id="id-d2277a7c49c241689865130a92eebe39"/>
    <element xsi:type="archimate:Constraint" name="O cadastro deve solicitar apenas informações essenciais como nome, CPF e localização. O sistema deve verificar pelo CPF se a nutriz já possui cadastro; caso exista, a jornada é retomada do ponto onde parou. O cadastro pode ser realizado via chatbot ou plataforma web, mantendo continuidade entre os canais." id="id-8f91131c91334aa6877d15daecf35841"/>
    <element xsi:type="archimate:Constraint" name="O painel deve permitir filtrar nutrizes cadastradas por região ou CEP. O disparo ocorre exclusivamente via WhatsApp Business API. O conteúdo é definido pela equipe do Lactare antes do envio e o resultado é registrado automaticamente no dashboard." id="id-84b91a517197412e931ccf736e0bbfe5"/>
    <element xsi:type="archimate:Constraint" name="A biblioteca deve conter artigos e vídeos organizados por tema. O painel de impacto deve exibir indicadores como total de doações realizadas e regiões atendidas. Ambos são gerenciados via painel administrativo, com dados aprovados pela equipe do Lactare antes da publicação." id="id-1aee72584f7e4381bec93c7bfc445c07"/>
    <element xsi:type="archimate:Principle" name="Solução digital que permita alcançar e engajar por meio de canais digitais" id="id-f4d821c62062414199a019a4da83bbb8"/>
    <element xsi:type="archimate:Principle" name=" Facilitar o acesso à informação priorizando uma jornada mais simples" id="id-ecec64184c9a42798aaaa44e87d75d4b"/>
    <element xsi:type="archimate:Principle" name="Monitorar jornada através de dashboards e indicadores estratégicos" id="id-fe421cf18f604a0d9729dfcdeb2fe32b"/>
    <element xsi:type="archimate:Outcome" name="Metade das nutrizes cadastradas encaminhadas para um ponto de coleta em até 7 dias após o cadastro" id="id-8e3ef791cc5e4844abb840fe7ed06fd9"/>
    <element xsi:type="archimate:Outcome" name="Aumentar taxa de confirmação de comparecimento ao ponto de coleta" id="id-2aebd452496841f191aac47164ec3728"/>
    <element xsi:type="archimate:Requirement" name="Orientar a nutriz sobre o processo de triagem e critérios de elegibilidade para doação" id="id-6913b4e027634aadb78bc94b45f63d0d"/>
    <element xsi:type="archimate:Requirement" name="Localizar e encaminhar a nutriz ao ponto de coleta ou banco de leite mais próximo com base na região informada" id="id-7fe8152982aa456a850bda2ed58caa42"/>
    <element xsi:type="archimate:Requirement" name="Acompanhar a jornada da nutriz após o encaminhamento de forma personalizada" id="id-cf16e06fb16c45a590c5e55fca6056ee"/>
    <element xsi:type="archimate:Constraint" name="O sistema deve orientar a nutriz sobre as etapas do processo de triagem do Lactare, informando o que será avaliado, quais documentos ou informações deve levar e o que esperar durante o processo. Caso a nutriz relate alguma condição que possivelmente a impeça de doar, o sistema deve orientá-la a confirmar sua elegibilidade diretamente com a equipe do ponto de coleta." id="id-f906e36c7a044ac298940e918b1c13b4"/>
    <element xsi:type="archimate:Constraint" name="O encaminhamento deve ser baseado no CEP ou cidade informados no cadastro. O sistema deve retornar nome, endereço, horário de funcionamento e contato do ponto de coleta mais próximo. Caso não haja ponto de coleta na região atendida pelo Lactare, o sistema deve encaminhar a nutriz ao banco de leite mais próximo via rede da rBLH. Após o encaminhamento, o chatbot deve enviar orientações sobre o que esperar no processo." id="id-10c3f142674642a3a62e317f10506c99"/>
    <element xsi:type="archimate:Constraint" name="Para nutrizes encaminhadas a bancos da Lactare, o sistema verifica pelo CPF se há agendamento e atua como facilitador, informando data, horário e local da consulta e oferecendo lembretes opcionais, sempre com a nutriz no controle de recebê-los ou não.Para nutrizes encaminhadas a bancos terceiros via rBLH, em que não há acesso ao status do agendamento, o acompanhamento é não intrusivo. Após um intervalo de dois dias, o sistema envia uma única mensagem acolhedora perguntando como está indo e se precisa de ajuda, sem exigir resposta. Se a nutriz avançou, registra a conversão; se ainda não, oferece ajuda; se não responde, nenhum novo lembrete é disparado." id="id-d83e337671c94705a98c14f3398db644"/>
    <element xsi:type="archimate:Requirement" name="Consolidar e exibir indicadores de alcance, engajamento e conversão das nutrizes" id="id-539edfabae55407094f5fe728028d3ee"/>
    <element xsi:type="archimate:Outcome" name="Identificar as etapas com maior abandono nas primeiras semanas" id="id-2bf374130a09407784bddd65a28409f5"/>
    <element xsi:type="archimate:Assessment" name="Dashboard via plataforma web para gestores Lactare" id="id-efa65e28508b446d9c610bd204ecf591"/>
    <element xsi:type="archimate:Constraint" name="O dashboard deve exibir alcance das comunicações, engajamento das nutrizes e conversão, como interesse ou início de contato para doação. Os dados devem ser filtráveis por período e região." id="id-459432946ad84364b5b6599c9508c78c"/>
    <element xsi:type="archimate:Assessment" name="Interação da nutriz via WhatsApp e Instagram sem necessidade de App externo" id="id-392c1056e38e447eb9e9d74fc61d0ac3"/>
    <element xsi:type="archimate:Requirement" name="Identificar o ponto de abandono da nutriz ao longo da jornada" id="id-e126f40ea8454431bb6bb85e82eac1aa"/>
    <element xsi:type="archimate:Requirement" name="Consolidar e exibir indicadores de alcance, engajamento e conversão das nutrizes (copy)" id="id-c475bdf8f3db486d92ac6440d7f5163d"/>
    <element xsi:type="archimate:Constraint" name="O sistema deve registrar o horário de conclusão de cada etapa da jornada e identificar automaticamente onde a nutriz abandonou o processo." id="id-fe6205524f2a4c98abb3f6c2473e1982"/>
    <element xsi:type="archimate:Requirement" name="Os dados do dashboard devem ser atualizados em tempo real" id="id-53b77576d674488fb9357548fb055991"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-8eb67c4774e943be87987ce794a7180b"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-d1d9cb8ffbdb40d8bb16b704f20dd00e"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-c25274166e8344ac812200ab065bc49a"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-d1298ca8a08b4cb4b397c71d21b2c918"/>
  </folder>
