generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VIEWER
}

enum UnitType {
  MILK_BANK
  COLLECTION_POINT
  HOSPITAL
  PARTNER
}

enum UnitStatus {
  PENDING
  ACTIVE
  INACTIVE
}

/// Sub-regiões usadas pelo Lactare para analisar a cobertura da Grande São
/// Paulo. Não representam unidades físicas nem promessa de coleta.
enum ServiceRegion {
  CAPITAL
  WEST
  SOUTHWEST
  ABC
  NORTH
  EAST_ALTO_TIETE
}

enum InterestStatus {
  INTERESTED
  CONTACTED
  DONATED
  UNKNOWN
}

/// Etapa categórica informada manualmente pela equipe do Lactare. Este enum
/// não representa triagem automática e não carrega detalhes clínicos.
enum JourneyStatus {
  REGISTERED
  DOCUMENT_SENT
  FORM_RECEIVED
  EXAM_SCHEDULED
  EXAMS_COMPLETED
  AWAITING_RESULT
  ELIGIBLE
  NOT_ELIGIBLE
  KIT_SENT
  KIT_DELIVERED
  DONATION_CONFIRMED
  RECURRING_DONATION_ELIGIBLE
}

enum NutrizRecognitionKind {
  JOURNEY_STARTED
  READY_FOR_DONATION
  KIT_RECEIVED
  FIRST_DONATION
  CONTINUITY_RECOGNIZED
}

enum ContactPreference {
  WHATSAPP
  EMAIL
  NONE
}

/// Canal oficial do Lactare clicado por uma visitante (RF07). Lista fechada
/// porque cada valor corresponde a um canal publicado em
/// `lib/constants/lactare-contact.ts` — não existe canal genérico.
enum ContactChannel {
  WHATSAPP
  PHONE
}

/// Superfície do produto onde o clique aconteceu. Hoje só o resultado positivo
/// da verificação de cobertura oferece os canais; novos pontos de contato
/// entram aqui por migration, junto com a tela que os expõe.
enum ContactChannelSurface {
  COVERAGE_RESULT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Situação de um agendamento **autodeclarado** pela nutriz no chatbot. A
/// plataforma não confirma nada: quem marcou foi a unidade, por fora. Por isso
/// não existe `CONFIRMED` — a interface diz "informado por você", nunca
/// "confirmado pelo banco de leite" (ver seção 13 do AGENTS.md).
enum AppointmentStatus {
  DECLARED
  NOT_SCHEDULED
  CANCELLED
  COMPLETED
}

/// Motivo de a nutriz não ter conseguido agendar. Lista fechada porque é
/// respondida por botões no WhatsApp, não por texto livre.
enum AppointmentFailureReason {
  NO_ANSWER
  NO_SLOT
  TOO_FAR
  GAVE_UP
  OTHER
}

/// Passo da conversa do chatbot. O webhook é sem estado próprio: o passo atual
/// mora no banco, indexado pelo número de WhatsApp.
enum WhatsappConversationStep {
  MENU
  FAQ
  AWAITING_COVERAGE
  AWAITING_FULL_NAME
  AWAITING_CONSENT
  AWAITING_REMINDER_REFERENCE
  HUMAN_HANDOFF

  // Estados do fluxo antigo. Permanecem no enum para que a migration preserve
  // os registros existentes; a aplicação os reinicia no menu quando reaparecem.
  ASKED_SCHEDULED
  AWAITING_DATE
  AWAITING_DATE_CONFIRMATION
  AWAITING_FAILURE_REASON
  FINISHED
}

/// Finalidade específica e independente dos demais consentimentos.
enum CommunicationConsentPurpose {
  JOURNEY_STATUS_WHATSAPP
  REMINDERS_WHATSAPP
}

enum CommunicationConsentDecision {
  GRANTED
  WITHDRAWN
}

enum CommunicationConsentSource {
  WEB
  WHATSAPP
}

enum NotificationOutboxKind {
  JOURNEY_STATUS_CHANGED
  REMINDER
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  RETRY_SCHEDULED
  SENT
  FAILED
  SUPPRESSED
}

enum NotificationDeliveryAttemptOutcome {
  SENT
  RETRY_SCHEDULED
  FAILED
  SUPPRESSED
}

/// Opções mínimas e não clínicas de como a nutriz se sentiu ao registrar um
/// momento de bem-estar. Não é diário de saúde nem avaliação terapêutica.
enum WellbeingFeeling {
  GOOD
  OK
  TIRED
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  fullName    String    @map("full_name")
  role        UserRole  @default(VIEWER)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  unitsResponsible Unit[]                 @relation("AdminResponsible")
  auditLogs        AuditLog[]
  campaigns        Campaign[]
  contentsEdited   EducationalContent[]
  journeyChanges   JourneyStatusHistory[] @relation("JourneyStatusChangedBy")

  @@map("users")
}

model NutrizProfile {
  id                String            @id @default(uuid())
  /// `id` do usuário em `auth.users` (Supabase Auth), quando a nutriz tem conta.
  /// Nulo para quem se cadastrou só como lead. **Não** usa a tabela `users`, que
  /// é do staff (ADMIN/VIEWER) e é o que o `requireAdminUser()` consulta.
  authUserId        String?           @unique @map("auth_user_id")
  fullName          String            @map("full_name")
  /// Único porque é o identificador da nutriz no chatbot: o webhook resolve o
  /// perfil a partir do número que enviou a mensagem.
  phoneWhatsapp     String            @unique @map("phone_whatsapp")
  email             String?
  state             String            @db.Char(2)
  city              String
  neighborhood      String?
  interestStatus    InterestStatus    @default(INTERESTED) @map("interest_status")
  /// Estado operacional atual da jornada. É independente do `interestStatus`
  /// legado e só pode avançar pelas transições explícitas do domínio.
  journeyStatus     JourneyStatus     @default(REGISTERED) @map("journey_status")
  contactPreference ContactPreference @default(WHATSAPP) @map("contact_preference")
  lgpdConsentAt     DateTime          @map("lgpd_consent_at")
  marketingConsent  Boolean           @default(false) @map("marketing_consent")
  sourceUtm         Json?             @map("source_utm")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  contactIntents        ContactIntent[]
  whatsappClicks        WhatsappClick[]
  appointments          Appointment[]
  conversations         WhatsappConversation[]
  journeyHistory        JourneyStatusHistory[]
  communicationConsents CommunicationConsentEvent[]
  notificationOutbox    NotificationOutbox[]
  extractionLogs         ExtractionLog[]
  wellbeingEntries       WellbeingEntry[]
  recognitions           NutrizRecognition[]

  @@index([state, city, createdAt])
  @@index([journeyStatus, createdAt])
  @@map("nutriz_profiles")
}

/// Registro pessoal da nutriz. Não representa doação, coleta ou agendamento.
/// A nutriz pode remover seus próprios registros.
model ExtractionLog {
  id              String   @id @default(uuid())
  nutrizProfileId String   @map("nutriz_profile_id")
  recordedAt      DateTime @map("recorded_at")
  volumeMl        Int      @map("volume_ml")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  nutrizProfile NutrizProfile @relation(fields: [nutrizProfileId], references: [id], onDelete: Cascade)

  @@index([nutrizProfileId, recordedAt])
  @@map("extraction_logs")
}

/// Registro opcional, mínimo e não clínico de bem-estar após uma doação.
model WellbeingEntry {
  id              String           @id @default(uuid())
  nutrizProfileId String           @map("nutriz_profile_id")
  feeling         WellbeingFeeling
  recordedAt      DateTime         @map("recorded_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  nutrizProfile NutrizProfile @relation(fields: [nutrizProfileId], references: [id], onDelete: Cascade)

  @@index([nutrizProfileId, recordedAt])
  @@map("wellbeing_entries")
}

/// Reconhecimento simbólico, cumulativo e derivado somente do status da jornada.
model NutrizRecognition {
  id              String                @id @default(uuid())
  nutrizProfileId String                @map("nutriz_profile_id")
  kind            NutrizRecognitionKind
  journeyStatus   JourneyStatus         @map("journey_status")
  assignedAt      DateTime              @default(now()) @map("assigned_at")

  nutrizProfile NutrizProfile @relation(fields: [nutrizProfileId], references: [id], onDelete: Cascade)

  @@unique([nutrizProfileId, kind], map: "nutriz_recognitions_profile_kind_key")
  @@index([nutrizProfileId, assignedAt], map: "nutriz_recognitions_profile_assigned_idx")
  @@map("nutriz_recognitions")
}

/// Registro append-only de uma mudança de status feita por um administrador.
/// A migration protege as linhas contra UPDATE/DELETE e também replica no
/// banco as transições permitidas pelo domínio.
model JourneyStatusHistory {
  id                 String        @id @default(uuid())
  nutrizProfileId    String        @map("nutriz_profile_id")
  fromStatus         JourneyStatus @map("from_status")
  toStatus           JourneyStatus @map("to_status")
  changedByUserId    String        @map("changed_by_user_id")
  /// Contexto estritamente operacional; nunca tipo de exame, valor, laudo,
  /// diagnóstico ou motivo clínico.
  administrativeNote String?       @map("administrative_note") @db.VarChar(500)
  changedAt          DateTime      @default(now()) @map("changed_at")

  nutrizProfile NutrizProfile       @relation(fields: [nutrizProfileId], references: [id], onDelete: Restrict)
  changedByUser User                @relation("JourneyStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  notification  NotificationOutbox?

  @@index([nutrizProfileId, changedAt])
  @@index([changedByUserId, changedAt])
  @@map("journey_status_history")
}

/// Registro append-only de uma concessão ou retirada de consentimento. A
/// ausência de GRANTED vigente significa que nenhum aviso pode ser enviado.
model CommunicationConsentEvent {
  id              String                       @id @default(uuid())
  sequence        BigInt                       @unique(map: "communication_consent_events_sequence_key") @default(autoincrement())
  nutrizProfileId String                       @map("nutriz_profile_id")
  purpose         CommunicationConsentPurpose
  decision        CommunicationConsentDecision
  source          CommunicationConsentSource
  policyVersion   String                       @map("policy_version") @db.VarChar(32)
  /// Identificador externo opcional para tornar eventos do webhook idempotentes.
  sourceEventId   String?                      @unique(map: "communication_consent_events_source_event_id_key") @map("source_event_id") @db.VarChar(255)
  /// Data de calendário informada pela nutriz somente como referência do lembrete.
  referenceDate   DateTime?                    @map("reference_date") @db.Date
  recordedAt      DateTime                     @default(now()) @map("recorded_at")

  nutrizProfile      NutrizProfile        @relation(fields: [nutrizProfileId], references: [id], onDelete: Restrict)
  notificationOutbox NotificationOutbox[] @relation("NotificationConsentSnapshot")

  @@index([nutrizProfileId, purpose, sequence], map: "communication_consent_events_profile_purpose_sequence_idx")
  @@map("communication_consent_events")
}

/// Fila transacional de mensagens. Não duplica telefone nem nome: o destino é
/// lido do perfil somente quando um worker assume o item.
model NotificationOutbox {
  id                     String                   @id @default(uuid())
  idempotencyKey         String                   @unique(map: "notification_outbox_idempotency_key_key") @map("idempotency_key") @db.VarChar(255)
  kind                   NotificationOutboxKind
  status                 NotificationOutboxStatus @default(PENDING)
  nutrizProfileId        String                   @map("nutriz_profile_id")
  journeyStatusHistoryId String?                  @unique(map: "notification_outbox_journey_status_history_id_key") @map("journey_status_history_id")
  consentEventId         String?                  @map("consent_event_id")
  /// Payload operacional do tipo da mensagem. Para lembretes, guarda apenas
  /// a categoria e a data de referência; não guarda PII nem o corpo da mensagem.
  payload                Json?
  attemptCount           Int                      @default(0) @map("attempt_count")
  maxAttempts            Int                      @default(5) @map("max_attempts")
  availableAt            DateTime                 @default(now()) @map("available_at")
  lockedAt               DateTime?                @map("locked_at")
  lockToken              String?                  @unique(map: "notification_outbox_lock_token_key") @map("lock_token") @db.VarChar(64)
  sentAt                 DateTime?                @map("sent_at")
  failedAt               DateTime?                @map("failed_at")
  providerMessageId      String?                  @map("provider_message_id") @db.VarChar(255)
  lastErrorCode          String?                  @map("last_error_code") @db.VarChar(64)
  lastErrorAt            DateTime?                @map("last_error_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  nutrizProfile        NutrizProfile                 @relation(fields: [nutrizProfileId], references: [id], onDelete: Restrict)
  journeyStatusHistory JourneyStatusHistory?         @relation(fields: [journeyStatusHistoryId], references: [id], onDelete: Restrict)
  consentEvent         CommunicationConsentEvent?    @relation("NotificationConsentSnapshot", fields: [consentEventId], references: [id], onDelete: Restrict)
  attempts             NotificationDeliveryAttempt[]

  @@index([status, availableAt, createdAt], map: "notification_outbox_status_available_created_idx")
  @@index([nutrizProfileId, createdAt], map: "notification_outbox_nutriz_profile_id_created_at_idx")
  @@map("notification_outbox")
}

/// Auditoria append-only de cada tentativa efetiva do worker.
model NotificationDeliveryAttempt {
  id                String                             @id @default(uuid())
  outboxId          String                             @map("outbox_id")
  attemptNumber     Int                                @map("attempt_number")
  outcome           NotificationDeliveryAttemptOutcome
  providerMessageId String?                            @map("provider_message_id") @db.VarChar(255)
  errorCode         String?                            @map("error_code") @db.VarChar(64)
  attemptedAt       DateTime                           @default(now()) @map("attempted_at")

  outbox NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Restrict)

  @@unique([outboxId, attemptNumber], map: "notification_delivery_attempts_outbox_attempt_key")
  @@index([outcome, attemptedAt], map: "notification_delivery_attempts_outcome_attempted_at_idx")
  @@map("notification_delivery_attempts")
}

model Unit {
  id                  String     @id @default(uuid())
  slug                String     @unique
  name                String
  type                UnitType
  addressStreet       String     @map("address_street")
  addressNumber       String?    @map("address_number")
  addressComplement   String?    @map("address_complement")
  addressNeighborhood String     @map("address_neighborhood")
  addressCity         String     @map("address_city")
  addressState        String     @map("address_state") @db.Char(2)
  addressZip          String?    @map("address_zip")
  phone               String?
  whatsapp            String?
  email               String?
  openingHours        Json?      @map("opening_hours")
  instructions        String?    @db.Text
  whatsappMessage     String?    @map("whatsapp_message") @db.Text
  status              UnitStatus @default(PENDING)
  lat                 Float?
  lng                 Float?
  adminResponsibleId  String?    @map("admin_responsible_id")
  adminNotes          String?    @map("admin_notes") @db.Text
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  adminResponsible User?           @relation("AdminResponsible", fields: [adminResponsibleId], references: [id])
  contactIntents   ContactIntent[]
  whatsappClicks   WhatsappClick[]
  appointments     Appointment[]

  @@index([addressState, addressCity, status])
  @@index([status])
  @@map("units")
}

/// Município que faz parte da área de atuação configurada do Lactare.
///
/// Esta é a fonte operacional da verificação pública de cobertura. O modelo
/// legado `Unit` continua no schema apenas para preservar relações e dados
/// históricos, mas não alimenta mais a experiência pública nem a gestão da
/// área atendida.
model ServiceMunicipality {
  id        String        @id @default(uuid())
  slug      String        @unique
  name      String
  state     String        @default("SP") @db.Char(2)
  country   String        @default("Brazil")
  region    ServiceRegion
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([name, state, country])
  @@index([isActive, name])
  @@index([region, isActive])
  @@map("service_municipalities")
}

model ContactIntent {
  id              String   @id @default(uuid())
  nutrizProfileId String?  @map("nutriz_profile_id")
  unitId          String?  @map("unit_id")
  state           String?  @db.Char(2)
  city            String?
  sourceUtm       Json?    @map("source_utm")
  userAgent       String?  @map("user_agent")
  ipHash          String?  @map("ip_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  nutrizProfile NutrizProfile? @relation(fields: [nutrizProfileId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id])

  @@index([createdAt, state])
  @@map("contact_intents")
}

model WhatsappClick {
  id              String   @id @default(uuid())
  unitId          String   @map("unit_id")
  nutrizProfileId String?  @map("nutriz_profile_id")
  sourceUtm       Json?    @map("source_utm")
  referrer        String?
  createdAt       DateTime @default(now()) @map("created_at")

  unit          Unit           @relation(fields: [unitId], references: [id])
  nutrizProfile NutrizProfile? @relation(fields: [nutrizProfileId], references: [id])

  @@index([createdAt, unitId])
  @@map("whatsapp_clicks")
}

/// Clique em um canal oficial do Lactare (RF07).
///
/// Substitui o tracking legado de `WhatsappClick`, que dependia de `Unit` e da
/// busca nacional aposentada. O evento é **anônimo e agregado**: não referencia
/// nutriz, unidade, CEP, telefone, IP nem referrer — só o canal, a superfície
/// que o exibiu e a campanha de origem, que é o mínimo para medir engajamento
/// sem tratar dado pessoal.
model ContactChannelClick {
  id        String                @id @default(uuid())
  channel   ContactChannel
  surface   ContactChannelSurface
  /// Somente as 5 chaves UTM, já sanitizadas por `sanitizeSourceUtm`. Serve à
  /// atribuição de campanha do RF10 e nunca carrega a URL completa.
  sourceUtm Json?                 @map("source_utm")
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([createdAt, channel])
  @@index([channel, surface, createdAt])
  @@map("contact_channel_clicks")
}

/// Agendamento que a nutriz marcou **diretamente com a unidade** e depois
/// informou ao chatbot. `unitId` é opcional porque ela pode não dizer com qual
/// banco falou; `scheduledAt` é nulo quando a resposta foi "não consegui", caso
/// em que `failureReason` explica o quê.
model Appointment {
  id              String                    @id @default(uuid())
  reference       String                    @unique
  nutrizProfileId String                    @map("nutriz_profile_id")
  unitId          String?                   @map("unit_id")
  status          AppointmentStatus         @default(DECLARED)
  scheduledAt     DateTime?                 @map("scheduled_at")
  failureReason   AppointmentFailureReason? @map("failure_reason")
  declaredAt      DateTime                  @default(now()) @map("declared_at")
  cancelledAt     DateTime?                 @map("cancelled_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  nutrizProfile NutrizProfile @relation(fields: [nutrizProfileId], references: [id])
  unit          Unit?         @relation(fields: [unitId], references: [id])

  @@index([nutrizProfileId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("appointments")
}

/// Estado da conversa do chatbot, chaveado pelo número. Fica separado de
/// `NutrizProfile` porque o bot também recebe mensagem de quem nunca se
/// cadastrou — nesse caso `nutrizProfileId` é nulo.
model WhatsappConversation {
  id                 String                   @id @default(uuid())
  phoneWhatsapp      String                   @unique @map("phone_whatsapp")
  nutrizProfileId    String?                  @map("nutriz_profile_id")
  step               WhatsappConversationStep @default(MENU)
  /// Rascunho mínimo do fluxo: somente cidade/UF resolvidas. Nome e CEP nunca
  /// entram aqui; o nome só é gravado no perfil depois do consentimento.
  context            Json?
  misunderstoodCount Int                      @default(0) @map("misunderstood_count")
  /// Data que a nutriz digitou e ainda não confirmou no passo seguinte.
  /// Campo legado preservado até a remoção segura do modelo de agendamento.
  draftScheduledAt   DateTime?                @map("draft_scheduled_at")
  lastMessageAt      DateTime                 @default(now()) @map("last_message_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  nutrizProfile NutrizProfile? @relation(fields: [nutrizProfileId], references: [id])

  @@map("whatsapp_conversations")
}

model EducationalContent {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  bodyMarkdown    String    @map("body_markdown") @db.Text
  category        String?
  isPublished     Boolean   @default(false) @map("is_published")
  publishedAt     DateTime? @map("published_at")
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  updatedByUser User? @relation(fields: [updatedByUserId], references: [id])

  @@map("educational_contents")
}

model Campaign {
  id              String   @id @default(uuid())
  name            String
  utmSource       String   @map("utm_source")
  utmMedium       String   @map("utm_medium")
  utmCampaign     String   @map("utm_campaign")
  landingUrl      String   @map("landing_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  createdByUser User @relation(fields: [createdByUserId], references: [id])

  @@map("campaigns")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  action    AuditAction
  entity    String
  entityId  String      @map("entity_id")
  diff      Json?
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
